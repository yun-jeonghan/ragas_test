# 시작용 최소 설정
# 기본은 로컬 Ollama다. RAM을 아끼려면 qwen2.5:0.5b + nomic-embed-text 조합을 먼저 쓴다.
# 이 저장소는 GREV_LLM_* 나 GREV_VLLM_* 에 자동으로 기대지 않는다.
# Ragas용과 BenchmarkQED용 값을 각각 직접 넣어야 한다.

# Ragas 평가용 LLM
GREV_RAGAS_PROVIDER=ollama
GREV_RAGAS_MODEL=qwen2.5:0.5b
GREV_RAGAS_BASE_URL=http://127.0.0.1:11434/v1
GREV_RAGAS_API_KEY=ollama
GREV_RAGAS_MAX_TOKENS=256
# GREV_RAGAS_TESTSET_SIZE=10
# GREV_RAGAS_QUESTION_MODES=default

# PDF 추출 모드.
# - chandra_only: 페이지 단위 OCR
# - mineru_hybrid: MinerU로 구조를 추출하고 이미지/그래프 설명은 chandra로 보강
GREV_PDF_EXTRACTOR_MODE=chandra_only
GREV_PDF_OCR_BACKEND=chandra
# GREV_PDF_DESCRIPTION_BACKEND=chandra
# GREV_PDF_MINERU_COMMAND=mineru
# GREV_PDF_MINERU_OUTPUT_ARTIFACT=*content_list*.json

# vLLM로 바꿀 때는 아래처럼 쓴다.
# GREV_RAGAS_PROVIDER=vllm
# GREV_RAGAS_MODEL=your-vllm-model-name
# GREV_RAGAS_BASE_URL=http://127.0.0.1:8000/v1
# GREV_RAGAS_API_KEY=vllm
# GREV_RAGAS_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Ragas 평가용 embeddings
GREV_RAGAS_EMBEDDINGS_PROVIDER=ollama
GREV_RAGAS_EMBEDDINGS_MODEL=nomic-embed-text
GREV_RAGAS_EMBEDDINGS_BASE_URL=http://127.0.0.1:11434/v1
GREV_RAGAS_EMBEDDINGS_API_KEY=ollama
GREV_RAGAS_EMBEDDINGS_MAX_SEQ_LENGTH=128

# CPU 임베딩 테스트를 할 때는 아래처럼 바꾼다.
# GREV_RAGAS_EMBEDDINGS_PROVIDER=local
# GREV_RAGAS_EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
# GREV_RAGAS_EMBEDDINGS_DEVICE=cpu
# GREV_RAGAS_EMBEDDINGS_NORMALIZE=true
# GREV_RAGAS_EMBEDDINGS_QUERY_PREFIX=query: 
# GREV_RAGAS_EMBEDDINGS_DOCUMENT_PREFIX=passage: 
# GREV_RAGAS_EMBEDDINGS_MAX_SEQ_LENGTH=128

# BenchmarkQED 스타일 AutoE용 LLM
GREV_BENCHMARKQED_PROVIDER=ollama
GREV_BENCHMARKQED_MODEL=qwen2.5:0.5b
GREV_BENCHMARKQED_BASE_URL=http://127.0.0.1:11434/v1
GREV_BENCHMARKQED_API_KEY=ollama
GREV_BENCHMARKQED_MAX_TOKENS=256

# vLLM로 바꿀 때는 아래처럼 쓴다.
# GREV_BENCHMARKQED_PROVIDER=vllm
# GREV_BENCHMARKQED_MODEL=your-vllm-model-name
# GREV_BENCHMARKQED_BASE_URL=http://127.0.0.1:8000/v1
# GREV_BENCHMARKQED_API_KEY=vllm
# GREV_BENCHMARKQED_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# BenchmarkQED 스타일 AutoE용 embeddings
GREV_BENCHMARKQED_EMBEDDINGS_PROVIDER=ollama
GREV_BENCHMARKQED_EMBEDDINGS_MODEL=nomic-embed-text
GREV_BENCHMARKQED_EMBEDDINGS_BASE_URL=http://127.0.0.1:11434/v1
GREV_BENCHMARKQED_EMBEDDINGS_API_KEY=ollama
GREV_BENCHMARKQED_EMBEDDINGS_MAX_SEQ_LENGTH=128

# BenchmarkQED도 CPU embeddings를 쓰려면 아래처럼 바꾼다.
# GREV_BENCHMARKQED_EMBEDDINGS_PROVIDER=local
# GREV_BENCHMARKQED_EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
# GREV_BENCHMARKQED_EMBEDDINGS_DEVICE=cpu
# GREV_BENCHMARKQED_EMBEDDINGS_NORMALIZE=true
# GREV_BENCHMARKQED_EMBEDDINGS_MAX_SEQ_LENGTH=128

# kg-gen MINE 스타일 판정용 LLM
GREV_KGGEN_MINE_PROVIDER=ollama
GREV_KGGEN_MINE_MODEL=qwen2.5:0.5b
GREV_KGGEN_MINE_BASE_URL=http://127.0.0.1:11434/v1
GREV_KGGEN_MINE_API_KEY=ollama
GREV_KGGEN_MINE_MAX_TOKENS=256

# vLLM로 바꿀 때는 아래처럼 쓴다.
# GREV_KGGEN_MINE_PROVIDER=vllm
# GREV_KGGEN_MINE_MODEL=your-vllm-model-name
# GREV_KGGEN_MINE_BASE_URL=http://127.0.0.1:8000/v1
# GREV_KGGEN_MINE_API_KEY=vllm
# GREV_KGGEN_MINE_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
