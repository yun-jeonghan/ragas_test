# Ragas 평가용 LLM 설정
# 기본은 OpenAI API 테스트용이다.
GREV_RAGAS_PROVIDER=openai
GREV_RAGAS_MODEL=gpt-4o-mini
GREV_RAGAS_API_KEY=your-openai-api-key

# vLLM로 바꿀 때는 아래처럼 쓴다.
# GREV_RAGAS_PROVIDER=vllm
# GREV_RAGAS_MODEL=your-vllm-model-name
# GREV_RAGAS_BASE_URL=http://127.0.0.1:8000/v1
# GREV_RAGAS_API_KEY=vllm
# GREV_RAGAS_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Ragas 평가용 embeddings 설정
GREV_RAGAS_EMBEDDINGS_PROVIDER=openai
GREV_RAGAS_EMBEDDINGS_MODEL=text-embedding-3-large
GREV_RAGAS_EMBEDDINGS_API_KEY=your-openai-api-key

# 로컬/대체 embedding endpoint를 쓸 때는 아래처럼 바꾼다.
# GREV_RAGAS_EMBEDDINGS_PROVIDER=openai
# GREV_RAGAS_EMBEDDINGS_MODEL=fake-embedding
# GREV_RAGAS_EMBEDDINGS_BASE_URL=http://127.0.0.1:8002/v1
# GREV_RAGAS_EMBEDDINGS_API_KEY=dummy

# BenchmarkQED 스타일 AutoE용 LLM 설정
# 기본은 Ragas 평가와 같은 OpenAI API를 쓴다.
GREV_BENCHMARKQED_PROVIDER=openai
GREV_BENCHMARKQED_MODEL=gpt-4o-mini
GREV_BENCHMARKQED_API_KEY=your-openai-api-key

# vLLM로 바꿀 때는 아래처럼 쓴다.
# GREV_BENCHMARKQED_PROVIDER=vllm
# GREV_BENCHMARKQED_MODEL=your-vllm-model-name
# GREV_BENCHMARKQED_BASE_URL=http://127.0.0.1:8000/v1
# GREV_BENCHMARKQED_API_KEY=vllm
# GREV_BENCHMARKQED_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# BenchmarkQED 스타일 AutoE용 embeddings 설정
GREV_BENCHMARKQED_EMBEDDINGS_PROVIDER=openai
GREV_BENCHMARKQED_EMBEDDINGS_MODEL=text-embedding-3-large
GREV_BENCHMARKQED_EMBEDDINGS_API_KEY=your-openai-api-key
