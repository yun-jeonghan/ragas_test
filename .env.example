# 시작용 최소 설정
# 아래 블록만 먼저 채우면 된다.
# - MODEL: 서버가 실제로 서빙하는 모델 이름
# - BASE_URL: /v1 까지 포함한 OpenAI-compatible 주소
# - API_KEY: 서버에 따라 비워두거나 토큰을 넣는다

# Ragas 평가용 LLM
GREV_RAGAS_PROVIDER=openai
GREV_RAGAS_MODEL=gpt-4o-mini
GREV_RAGAS_API_KEY=your-openai-api-key

# 공용 vLLM 블록.
# Ragas / BenchmarkQED 둘 다 같은 GPU endpoint를 쓸 때 여기만 채우면 된다.
# OpenAI-compatible endpoint 전체를 넣는다. 보통 /v1 까지 포함한다.
# GREV_VLLM_PROVIDER=vllm
# GREV_VLLM_MODEL=your-vllm-model-name
# GREV_VLLM_BASE_URL=http://127.0.0.1:8000/v1
# GREV_VLLM_API_KEY=vllm
# GREV_VLLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# GREV_VLLM_EMBEDDINGS_PROVIDER=vllm
# GREV_VLLM_EMBEDDINGS_MODEL=your-embedding-model-name
# GREV_VLLM_EMBEDDINGS_BASE_URL=http://127.0.0.1:8000/v1
# GREV_VLLM_EMBEDDINGS_API_KEY=vllm
# GREV_VLLM_EMBEDDINGS_EXTRA_BODY={}

# PDF 추출 모드.
# - chandra_only: 페이지 단위 OCR
# - mineru_hybrid: MinerU로 구조를 추출하고 이미지/그래프 설명은 chandra로 보강
GREV_PDF_EXTRACTOR_MODE=chandra_only
GREV_PDF_OCR_BACKEND=chandra
# GREV_PDF_DESCRIPTION_BACKEND=chandra
# GREV_PDF_MINERU_COMMAND=mineru
# GREV_PDF_MINERU_OUTPUT_ARTIFACT=*content_list*.json

# vLLM로 바꿀 때는 아래처럼 쓴다.
# GREV_RAGAS_PROVIDER=vllm
# GREV_RAGAS_MODEL=your-vllm-model-name
# GREV_RAGAS_BASE_URL=http://127.0.0.1:8000/v1
# GREV_RAGAS_API_KEY=vllm
# GREV_RAGAS_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Ragas 평가용 embeddings
GREV_RAGAS_EMBEDDINGS_PROVIDER=openai
GREV_RAGAS_EMBEDDINGS_MODEL=text-embedding-3-large
GREV_RAGAS_EMBEDDINGS_API_KEY=your-openai-api-key

# CPU 임베딩 테스트를 할 때는 아래처럼 바꾼다.
# GREV_RAGAS_EMBEDDINGS_PROVIDER=local
# GREV_RAGAS_EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
# GREV_RAGAS_EMBEDDINGS_DEVICE=cpu
# GREV_RAGAS_EMBEDDINGS_NORMALIZE=true
# GREV_RAGAS_EMBEDDINGS_QUERY_PREFIX=query: 
# GREV_RAGAS_EMBEDDINGS_DOCUMENT_PREFIX=passage: 

# 로컬/대체 embedding endpoint를 쓸 때는 아래처럼 바꾼다.
# embeddings도 같은 vLLM 서버를 쓰면 BASE_URL을 같은 값으로 두면 된다.
# GREV_RAGAS_EMBEDDINGS_PROVIDER=openai
# GREV_RAGAS_EMBEDDINGS_MODEL=fake-embedding
# GREV_RAGAS_EMBEDDINGS_BASE_URL=http://127.0.0.1:8002/v1
# GREV_RAGAS_EMBEDDINGS_API_KEY=dummy

# BenchmarkQED 스타일 AutoE용 LLM
GREV_BENCHMARKQED_PROVIDER=openai
GREV_BENCHMARKQED_MODEL=gpt-4o-mini
GREV_BENCHMARKQED_API_KEY=your-openai-api-key

# vLLM로 바꿀 때는 아래처럼 쓴다.
# chat/completions endpoint가 /v1 인 OpenAI-compatible 형태여야 한다.
# GREV_BENCHMARKQED_PROVIDER=vllm
# GREV_BENCHMARKQED_MODEL=your-vllm-model-name
# GREV_BENCHMARKQED_BASE_URL=http://127.0.0.1:8000/v1
# GREV_BENCHMARKQED_API_KEY=vllm
# GREV_BENCHMARKQED_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# BenchmarkQED 스타일 AutoE용 embeddings
GREV_BENCHMARKQED_EMBEDDINGS_PROVIDER=openai
GREV_BENCHMARKQED_EMBEDDINGS_MODEL=text-embedding-3-large
GREV_BENCHMARKQED_EMBEDDINGS_API_KEY=your-openai-api-key

# BenchmarkQED도 CPU embeddings를 쓰려면 아래처럼 바꾼다.
# GREV_BENCHMARKQED_EMBEDDINGS_PROVIDER=local
# GREV_BENCHMARKQED_EMBEDDINGS_MODEL=intfloat/multilingual-e5-small
# GREV_BENCHMARKQED_EMBEDDINGS_DEVICE=cpu
# GREV_BENCHMARKQED_EMBEDDINGS_NORMALIZE=true
